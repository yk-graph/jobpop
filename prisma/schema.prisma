generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum VisaType {
  WORK_HOLIDAY // ワーキングホリデー（IEC）- フルタイム就労可
  STUDY_PERMIT // 学生ビザ - 週24時間まで就労可
  COOP_STUDY // Coop留学 - 実習期間はフルタイム就労可
  PGWP // 卒業後就労ビザ（Post-Graduation Work Permit）- フルタイム就労可
  WORK_PERMIT // その他の就労ビザ（LMIA経由など）- フルタイム就労可
  PERMANENT_RESIDENT // 永住者（PR）- 就労制限なし
  CITIZEN // カナダ市民 - 就労制限なし
  OTHER // その他
}

enum EmploymentType {
  FULL_TIME // 正社員
  PART_TIME // パート・アルバイト
  CONTRACT // 契約社員
  INTERNSHIP // インターン
  FREELANCE // フリーランス
}

enum ApplicationStatus {
  APPLIED // 応募済み
  REVIEWING // 選考中
  INTERVIEW // 面接段階
  ACCEPTED // 採用
  REJECTED // 不採用
  WITHDRAWN // 応募取り下げ
}

enum IndustryType {
  FOOD // 飲食
  RETAIL // 小売
  HOSPITALITY // 宿泊・ホテル
  HEALTHCARE // ヘルスケア・介護
  BEAUTY // 美容
  DELIVERY // 配送・デリバリー
  FITNESS // フィットネス
  LOGISTICS // 物流・倉庫
  EDUCATION // 教育
  CORPORATE // 企業・オフィス
  ADMIN // 総務・人事・事務
  FINANCE // 経理・会計
  TECH // テック
  MARKETING // マーケティング
  MEDIA // メディア・クリエイティブ
}

enum SoftSkill {
  DIGITAL_COMMUNICATION_FLUENCY // Digital Communication Fluency
  LEARNING_AGILITY // Learning Agility
  CULTURAL_INTELLIGENCE // Cultural Intelligence
  EMOTIONAL_RESILIENCE // Emotional Resilience
  ATTENTION_SWITCHING // Attention Switching
  TECHNO_EMOTIONAL_BALANCE // Techno-Emotional Balance
  COLLABORATIVE_CREATIVITY // Collaborative Creativity
}

enum SalaryType {
  HOURLY // 時給
  MONTHLY // 月給
  ANNUAL // 年俸
}

enum EmployeeRole {
  OWNER // オーナー（全権限）
  ADMIN // 管理者（企業全体の管理権限）
  MANAGER // 店舗マネージャー（特定店舗の管理権限）
  STAFF // スタッフ（閲覧のみ、または限定的な編集権限）
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum DayGroup {
  WEEKDAYS // Mon-Fri
  WEEKENDS // Sat-Sun
  HOLIDAYS // Holidays (as a concept)
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum RequirementPriority {
  NICE
  NEED
  MUST
}

enum JobStatus {
  DRAFT // 下書き（非公開）
  PUBLISHED // 公開中
  PAUSED // 一時停止（非公開）
  CLOSED // 募集終了（非公開）
}
